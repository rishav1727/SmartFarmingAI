# ─────────────────────────────────────────────────────────────────────────────
# SmartFarmingAI — Environment Variables
# Copy this file to .env and fill in your values.
# NEVER commit .env to git.
# ─────────────────────────────────────────────────────────────────────────────

# ── Database ──────────────────────────────────────────────────────────────────
# Leave blank to use local SQLite (smartfarming.db) for development.
# For production, paste your Supabase / Render / Railway PostgreSQL URL:
#   postgresql://user:password@host:5432/dbname
DATABASE_URL=

# ── Supabase Storage ──────────────────────────────────────────────────────────
# Create a free project at https://supabase.com
# Then: Project Settings → API → copy URL and anon/public key
SUPABASE_URL=
SUPABASE_KEY=
SUPABASE_BUCKET=training-contributions

# ── HuggingFace Hub (model weight versioning) ─────────────────────────────────
# Create a free account at https://huggingface.co
# Then: Settings → Access Tokens → New Token (write)
HF_TOKEN=
# Your model repo, e.g.  your-username/SmartFarmingAI
HF_MODEL_REPO=

# ── Admin API protection ──────────────────────────────────────────────────────
# Anyone with this secret can trigger retraining via POST /api/admin/retrain
# Generate a strong random string, e.g.: python -c "import secrets; print(secrets.token_hex(32))"
ADMIN_SECRET=change_me_to_a_strong_secret

# ── AI Advisor ────────────────────────────────────────────────────────────────
OPENAI_API_KEY=

# ── Hardware ──────────────────────────────────────────────────────────────────
# Set to "1" to enable CUDA GPU inference (if available)
USE_CUDA=0

# ── Public base URL (for local-storage fallback image URLs) ───────────────────
# When Supabase is not configured, images are stored locally and served at:
#   BASE_URL/contributions/<filename>
# Set this to your public server URL in production.
BASE_URL=http://localhost:8000
